# Maintainer: Piero Proietti <piero.proietti@gmail.com>
pkgname=penguins-tailor
pkgver={{.BaseVersion}}
pkgrel={{.Rel}}
pkgdesc="penguins-tailor: dress up your Linux distribution"
arch=('x86_64')
url="https://github.com/pieroproietti/penguins-tailor"
license=('GPL3')
options=('!debug')

depends=(
	'git'
	'rsync'
)

provides=('penguins-tailor')

package() {
	mkdir -p "${pkgdir}/usr"

	cp -a "${startdir}/usr/"* "${pkgdir}/usr/"
	if [ -d "${startdir}/etc" ]; then
		mkdir -p "${pkgdir}/etc"
		cp -a "${startdir}/etc/"* "${pkgdir}/etc/"
	fi
}
